<Project>
  <PropertyGroup>
    <ComponentOneAssembliesPath
      Condition="'$(ComponentOneAssembliesPath)' == ''
              And '$(JASONQUERY_COMPONENTONE_DIR)' != ''">$(JASONQUERY_COMPONENTONE_DIR)</ComponentOneAssembliesPath>

    <ComponentOneAssembliesPath
      Condition="'$(ComponentOneAssembliesPath)' == ''">$(MSBuildThisFileDirectory).local\ComponentOne</ComponentOneAssembliesPath>

    <!-- Only the JasonQuery application directly imports ComponentOne references. -->
    <UseJasonQueryComponentOneReferences
      Condition="'$(MSBuildProjectFile)' == 'JasonQuery.csproj'">true</UseJasonQueryComponentOneReferences>

    <UseJasonQueryComponentOneReferences
      Condition="'$(UseJasonQueryComponentOneReferences)' == ''">false</UseJasonQueryComponentOneReferences>

    <DevartAssembliesPath
      Condition="'$(DevartAssembliesPath)' == ''
              And '$(JASONQUERY_DEVART_DIR)' != ''">$(JASONQUERY_DEVART_DIR)</DevartAssembliesPath>

    <DevartAssembliesPath
      Condition="'$(DevartAssembliesPath)' == ''">$(MSBuildThisFileDirectory).local\Devart</DevartAssembliesPath>

    <!-- 只有這兩個專案直接匯入 Devart 參考。 -->
    <UseJasonQueryDevartReferences
      Condition="'$(MSBuildProjectFile)' == 'JasonQuery.csproj'
              Or '$(MSBuildProjectFile)' == 'JasonQuery.IntegrationTests.csproj'">true</UseJasonQueryDevartReferences>

    <UseJasonQueryDevartReferences
      Condition="'$(UseJasonQueryDevartReferences)' == ''">false</UseJasonQueryDevartReferences>

    <SQLiteAssembliesPath
      Condition="'$(SQLiteAssembliesPath)' == ''
              And '$(JASONQUERY_SQLITE_DIR)' != ''">$(JASONQUERY_SQLITE_DIR)</SQLiteAssembliesPath>

    <SQLiteAssembliesPath
      Condition="'$(SQLiteAssembliesPath)' == ''">$(MSBuildThisFileDirectory).local\SQLite</SQLiteAssembliesPath>

    <!-- JasonQuery 主程式與 unit tests 使用 System.Data.SQLite 讀寫及驗證內部設定資料庫 -->
    <UseJasonQuerySQLiteReferences
      Condition="'$(MSBuildProjectFile)' == 'JasonQuery.csproj'
              Or '$(MSBuildProjectFile)' == 'JasonQuery.Tests.csproj'">true</UseJasonQuerySQLiteReferences>

    <UseJasonQuerySQLiteReferences
      Condition="'$(UseJasonQuerySQLiteReferences)' == ''">false</UseJasonQuerySQLiteReferences>
    <!--
      Isolated historical SQLite runtime used only by
      JasonQuery.LegacyDbMigration.exe.
    -->
    <LegacySQLiteAssembliesPath
      Condition="'$(LegacySQLiteAssembliesPath)' == ''
              And '$(JASONQUERY_LEGACY_SQLITE_DIR)' != ''">$(JASONQUERY_LEGACY_SQLITE_DIR)</LegacySQLiteAssembliesPath>

    <LegacySQLiteAssembliesPath
      Condition="'$(LegacySQLiteAssembliesPath)' == ''">$(MSBuildThisFileDirectory).local\SQLite\Legacy</LegacySQLiteAssembliesPath>

    <UseJasonQueryLegacySQLiteReferences
      Condition="'$(MSBuildProjectFile)' == 'JasonQuery.LegacyDbMigration.csproj'">true</UseJasonQueryLegacySQLiteReferences>

    <UseJasonQueryLegacySQLiteReferences
      Condition="'$(UseJasonQueryLegacySQLiteReferences)' == ''">false</UseJasonQueryLegacySQLiteReferences>
  </PropertyGroup>

  <Import
    Project="$(MSBuildThisFileDirectory)Build\ComponentOne.References.props"
    Condition="'$(UseJasonQueryComponentOneReferences)' == 'true'" />

  <Import
    Project="$(MSBuildThisFileDirectory)Build\Devart.References.props"
    Condition="'$(UseJasonQueryDevartReferences)' == 'true'" />

  <Import
    Project="$(MSBuildThisFileDirectory)Build\SQLite.References.props"
    Condition="'$(UseJasonQuerySQLiteReferences)' == 'true'" />
  <Import
    Project="$(MSBuildThisFileDirectory)Build\LegacySQLite.References.props"
    Condition="'$(UseJasonQueryLegacySQLiteReferences)' == 'true'" />

  <Target Name="ValidateJasonQueryComponentOneAssemblies"
          BeforeTargets="ResolveReferences"
          Condition="'$(UseJasonQueryComponentOneReferences)' == 'true'">

    <Message
      Text="ProjectFile=$(MSBuildProjectFile); UseComponentOne=[$(UseJasonQueryComponentOneReferences)]; ComponentOnePath=[$(ComponentOneAssembliesPath)]"
      Importance="High" />

    <Error Condition="!Exists('$(ComponentOneAssembliesPath)\C1.C1Excel.4.5.2.dll')"
           Text="Missing C1.C1Excel.4.5.2.dll in $(ComponentOneAssembliesPath)." />
    <Error Condition="!Exists('$(ComponentOneAssembliesPath)\C1.C1Zip.4.5.2.dll')"
           Text="Missing C1.C1Zip.4.5.2.dll in $(ComponentOneAssembliesPath)." />
    <Error Condition="!Exists('$(ComponentOneAssembliesPath)\C1.Win.4.5.2.dll')"
           Text="Missing C1.Win.4.5.2.dll in $(ComponentOneAssembliesPath)." />
    <Error Condition="!Exists('$(ComponentOneAssembliesPath)\C1.Win.Bitmap.4.5.2.dll')"
           Text="Missing C1.Win.Bitmap.4.5.2.dll in $(ComponentOneAssembliesPath)." />
    <Error Condition="!Exists('$(ComponentOneAssembliesPath)\C1.Win.C1Command.4.5.2.dll')"
           Text="Missing C1.Win.C1Command.4.5.2.dll in $(ComponentOneAssembliesPath)." />
    <Error Condition="!Exists('$(ComponentOneAssembliesPath)\C1.Win.C1DX.4.5.2.dll')"
           Text="Missing C1.Win.C1DX.4.5.2.dll in $(ComponentOneAssembliesPath)." />
    <Error Condition="!Exists('$(ComponentOneAssembliesPath)\C1.Win.C1Input.4.5.2.dll')"
           Text="Missing C1.Win.C1Input.4.5.2.dll in $(ComponentOneAssembliesPath)." />
    <Error Condition="!Exists('$(ComponentOneAssembliesPath)\C1.Win.C1Ribbon.4.5.2.dll')"
           Text="Missing C1.Win.C1Ribbon.4.5.2.dll in $(ComponentOneAssembliesPath)." />
    <Error Condition="!Exists('$(ComponentOneAssembliesPath)\C1.Win.C1SuperTooltip.4.5.2.dll')"
           Text="Missing C1.Win.C1SuperTooltip.4.5.2.dll in $(ComponentOneAssembliesPath)." />
    <Error Condition="!Exists('$(ComponentOneAssembliesPath)\C1.Win.C1Themes.4.5.2.dll')"
           Text="Missing C1.Win.C1Themes.4.5.2.dll in $(ComponentOneAssembliesPath)." />
    <Error Condition="!Exists('$(ComponentOneAssembliesPath)\C1.Win.C1Themes.Extended.4.5.2.dll')"
           Text="Missing C1.Win.C1Themes.Extended.4.5.2.dll in $(ComponentOneAssembliesPath)." />
    <Error Condition="!Exists('$(ComponentOneAssembliesPath)\C1.Win.C1TrueDBGrid.4.5.2.dll')"
           Text="Missing C1.Win.C1TrueDBGrid.4.5.2.dll in $(ComponentOneAssembliesPath)." />
    <Error Condition="!Exists('$(ComponentOneAssembliesPath)\C1.Win.C1TrueDBGrid.Excel.4.5.2.dll')"
           Text="Missing C1.Win.C1TrueDBGrid.Excel.4.5.2.dll in $(ComponentOneAssembliesPath)." />
    <Error Condition="!Exists('$(ComponentOneAssembliesPath)\C1.Win.Calendar.4.5.2.dll')"
           Text="Missing C1.Win.Calendar.4.5.2.dll in $(ComponentOneAssembliesPath)." />
    <Error Condition="!Exists('$(ComponentOneAssembliesPath)\C1.Win.Ribbon.4.5.2.dll')"
           Text="Missing C1.Win.Ribbon.4.5.2.dll in $(ComponentOneAssembliesPath)." />
  </Target>

  <Target Name="ValidateJasonQueryDevartAssemblies"
          BeforeTargets="ResolveReferences"
          Condition="'$(UseJasonQueryDevartReferences)' == 'true'">

    <Message
      Text="ProjectFile=$(MSBuildProjectFile); UseDevart=[$(UseJasonQueryDevartReferences)]; DevartPath=[$(DevartAssembliesPath)]"
      Importance="High" />

    <Error Condition="!Exists('$(DevartAssembliesPath)\Devart.Data.dll')"
           Text="Missing Devart.Data.dll in $(DevartAssembliesPath)." />

    <Error Condition="!Exists('$(DevartAssembliesPath)\Devart.Data.Oracle.dll')"
           Text="Missing Devart.Data.Oracle.dll in $(DevartAssembliesPath)." />

    <Error Condition="!Exists('$(DevartAssembliesPath)\Devart.Data.PostgreSql.dll')"
           Text="Missing Devart.Data.PostgreSql.dll in $(DevartAssembliesPath)." />

    <Error Condition="!Exists('$(DevartAssembliesPath)\Devart.Data.SqlServer.dll')"
           Text="Missing Devart.Data.SqlServer.dll in $(DevartAssembliesPath)." />

    <Error Condition="!Exists('$(DevartAssembliesPath)\Devart.Data.MySql.dll')"
           Text="Missing Devart.Data.MySql.dll in $(DevartAssembliesPath)." />

    <Error Condition="'$(MSBuildProjectFile)' == 'JasonQuery.csproj'
                  And !Exists('$(DevartAssembliesPath)\Devart.Data.SQLite.dll')"
           Text="Missing Devart.Data.SQLite.dll in $(DevartAssembliesPath)." />
  </Target>

  <Target Name="ValidateJasonQuerySQLiteAssemblies"
          BeforeTargets="ResolveReferences"
          Condition="'$(UseJasonQuerySQLiteReferences)' == 'true'">

    <Message
      Text="ProjectFile=$(MSBuildProjectFile); UseSQLite=[$(UseJasonQuerySQLiteReferences)]; SQLitePath=[$(SQLiteAssembliesPath)]"
      Importance="High" />

    <Error Condition="!Exists('$(SQLiteAssembliesPath)\System.Data.SQLite.dll')"
           Text="Missing System.Data.SQLite.dll in $(SQLiteAssembliesPath)." />

    <Error Condition="!Exists('$(SQLiteAssembliesPath)\System.Threading.Tasks.Extensions.dll')"
           Text="Missing System.Threading.Tasks.Extensions.dll in $(SQLiteAssembliesPath)." />

    <Error Condition="!Exists('$(SQLiteAssembliesPath)\SQLite.Interop.dll')"
           Text="Missing x64 SQLite.Interop.dll in $(SQLiteAssembliesPath)." />
  </Target>
  <Target Name="ValidateJasonQueryLegacySQLiteAssemblies"
          BeforeTargets="ResolveReferences"
          Condition="'$(UseJasonQueryLegacySQLiteReferences)' == 'true'">

    <Message
      Text="ProjectFile=$(MSBuildProjectFile); UseLegacySQLite=[$(UseJasonQueryLegacySQLiteReferences)]; LegacySQLitePath=[$(LegacySQLiteAssembliesPath)]"
      Importance="High" />

    <Error Condition="!Exists('$(LegacySQLiteAssembliesPath)\System.Data.SQLite.dll')"
           Text="Missing legacy System.Data.SQLite.dll in $(LegacySQLiteAssembliesPath)." />

    <Error Condition="!Exists('$(LegacySQLiteAssembliesPath)\System.Threading.Tasks.Extensions.dll')"
           Text="Missing legacy System.Threading.Tasks.Extensions.dll in $(LegacySQLiteAssembliesPath)." />

    <Error Condition="!Exists('$(LegacySQLiteAssembliesPath)\SQLite.Interop.dll')"
           Text="Missing legacy x64 SQLite.Interop.dll in $(LegacySQLiteAssembliesPath)." />
  </Target>
</Project>
