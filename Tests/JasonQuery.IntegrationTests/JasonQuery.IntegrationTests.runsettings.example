<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <TargetPlatform>x64</TargetPlatform>
  </RunConfiguration>

  <TestRunParameters>
    <!-- OracleReader uses the same individual fields as ConnectionForm. -->
    <Parameter name="Oracle.Enabled" value="false" />
    <Parameter name="Oracle.Server" value="127.0.0.1" />
    <Parameter name="Oracle.Port" value="1521" />
    <Parameter name="Oracle.User" value="JQ_TEST" />
    <Parameter name="Oracle.Password" value="CHANGE_ME" />
    <Parameter name="Oracle.Sid" value="FREEPDB1" />
    <Parameter name="Oracle.Schema" value="JQ_TEST" />
    <Parameter name="Oracle.ConnectAs" value="" />
    <Parameter name="Oracle.DirectMode" value="true" />
    <Parameter name="Oracle.Pooling" value="false" />
    <Parameter name="Oracle.Unicode" value="true" />
    <Parameter name="Oracle.QueryTimeoutSeconds" value="30" />

    <!-- Copy the connection string generated by JasonQuery ConnectionForm. -->
    <Parameter name="PostgreSql.Enabled" value="false" />
    <Parameter name="PostgreSql.ConnectionString" value="User ID=jq_test;Password=CHANGE_ME;Host=127.0.0.1;Port=5432;Database=jasonquery_integration;Pooling=false;Unicode=true;" />
    <Parameter name="PostgreSql.Database" value="jasonquery_integration" />
    <Parameter name="PostgreSql.Schema" value="jq_test" />
    <Parameter name="PostgreSql.QueryTimeoutSeconds" value="30" />

    <!-- Current ConnectionForm uses SQL Server Authentication. -->
    <Parameter name="SqlServer.Enabled" value="false" />
    <Parameter name="SqlServer.ConnectionString" value="User ID=jq_test;Password=CHANGE_ME;Data Source=127.0.0.1,1433;Initial Catalog=JasonQueryIntegration;Pooling=false;" />
    <Parameter name="SqlServer.Database" value="JasonQueryIntegration" />
    <Parameter name="SqlServer.Schema" value="dbo" />
    <Parameter name="SqlServer.QueryTimeoutSeconds" value="30" />

    <Parameter name="MySql.Enabled" value="false" />
    <Parameter name="MySql.ConnectionString" value="User ID=jq_test;Password=CHANGE_ME;Host=127.0.0.1;Port=3306;Database=jasonquery_integration;Pooling=false;Unicode=true;Protocol=Tcp;" />
    <Parameter name="MySql.Database" value="jasonquery_integration" />
    <Parameter name="MySql.QueryTimeoutSeconds" value="30" />
  </TestRunParameters>
</RunSettings>
