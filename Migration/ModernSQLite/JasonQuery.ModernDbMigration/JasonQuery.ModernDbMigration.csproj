<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RootNamespace>JasonQuery.ModernDbMigration</RootNamespace>
    <AssemblyName>JasonQuery.ModernDbMigration</AssemblyName>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Deterministic>true</Deterministic>
    <ModernSqlCipherNativePath Condition="'$(ModernSqlCipherNativePath)' == ''">$(MSBuildThisFileDirectory)..\..\..\.local\SQLite\Modern\sqlcipher.dll</ModernSqlCipherNativePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.core" Version="3.0.5" />
    <PackageReference Include="SQLitePCLRaw.provider.sqlcipher" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(ModernSqlCipherNativePath)"
          Link="sqlcipher.dll" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\JasonQuery\Core\Security\JasonQueryDb\JasonQueryDbStorageFormatContract.cs" Link="JasonQueryDbStorageFormatContract.cs" />
    <Compile Include="..\..\..\JasonQuery\Core\Security\JasonQueryDb\JasonQueryDbStorageFormatVersion.cs" Link="JasonQueryDbStorageFormatVersion.cs" />
    <Compile Include="..\..\..\JasonQuery\Core\Security\JasonQueryDb\JasonQueryDbStorageMigrationLogicalFrameKind.cs" Link="JasonQueryDbStorageMigrationLogicalFrameKind.cs" />
    <Compile Include="..\..\..\JasonQuery\Core\Security\JasonQueryDb\JasonQueryDbStorageMigrationLogicalSchema.cs" Link="JasonQueryDbStorageMigrationLogicalSchema.cs" />
    <Compile Include="..\..\..\JasonQuery\Core\Security\JasonQueryDb\JasonQueryDbStorageMigrationLogicalStreamContract.cs" Link="JasonQueryDbStorageMigrationLogicalStreamContract.cs" />
    <Compile Include="..\..\..\JasonQuery\Core\Security\JasonQueryDb\JasonQueryDbStorageMigrationLogicalStreamProtocol.cs" Link="JasonQueryDbStorageMigrationLogicalStreamProtocol.cs" />
    <Compile Include="..\..\..\JasonQuery\Core\Security\JasonQueryDb\JasonQueryDbStorageMigrationSchemaObjectKind.cs" Link="JasonQueryDbStorageMigrationSchemaObjectKind.cs" />
    <Compile Include="..\..\..\JasonQuery\Core\Security\JasonQueryDb\JasonQueryDbStorageMigrationValueKind.cs" Link="JasonQueryDbStorageMigrationValueKind.cs" />
    <Compile Include="..\..\..\JasonQuery\Core\Security\JasonQueryDb\JasonQueryDbStorageMigrationWireProtocol.cs" Link="JasonQueryDbStorageMigrationWireProtocol.cs" />
    <Compile Include="..\..\..\JasonQuery\Core\Security\JasonQueryDb\JasonQueryDbStorageV2CandidateWriterProtocol.cs" Link="JasonQueryDbStorageV2CandidateWriterProtocol.cs" />
    <Compile Include="..\..\..\JasonQuery\Core\Security\JasonQueryDb\JasonQueryDbStorageV2ReadOnlyValidatorProtocol.cs" Link="JasonQueryDbStorageV2ReadOnlyValidatorProtocol.cs" />
  </ItemGroup>

  <Target Name="ValidateQualifiedModernSqlCipherNative"
          BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(ModernSqlCipherNativePath)')"
           Text="Missing qualified sqlcipher.dll in $(ModernSqlCipherNativePath)." />
  </Target>

  <Target Name="CopyQualifiedModernSqlCipherNativeToOutput"
          AfterTargets="Build">
    <Copy SourceFiles="$(ModernSqlCipherNativePath)"
          DestinationFiles="$(TargetDir)sqlcipher.dll"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <FileWrites Include="$(TargetDir)sqlcipher.dll" />
    </ItemGroup>
  </Target>
</Project>
