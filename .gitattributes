# Normalize text files in the Git repository.
* text=auto

# Windows-specific project and script files.
*.sln text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix shell scripts.
*.sh text eol=lf

# Binary files.
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.cur binary
*.db binary
*.dll binary
*.exe binary
*.pdb binary
*.zip binary
*.7z binary
*.xls binary
*.xlsx binary
*.xlsm binary
*.doc binary
*.docx binary
*.pdf binary